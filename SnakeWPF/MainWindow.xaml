<Window x:Class="SnakeWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snake" Height="720" Width="900"
        MinWidth="760" MinHeight="640"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI" FontSize="16"
        KeyDown="Window_KeyDown" Loaded="Window_Loaded">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SNAKE" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Собирайте еду и не врезайтесь в себя или стены"
                           Foreground="#94A3B8" FontSize="14" Margin="0,2,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" Background="#1E293B" CornerRadius="12" Padding="18,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="СЧЁТ" Foreground="#94A3B8" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock x:Name="ScoreText" Text="0" FontSize="24" FontWeight="Bold"
                               Foreground="#86EFAC" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock Text="УПРАВЛЕНИЕ" FontSize="13" FontWeight="Bold"
                           Foreground="#64748B" Margin="0,0,0,14" />
                <TextBlock Text="↑  ↓  ←  →" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="или клавиши W A S D" Foreground="#94A3B8"
                           FontSize="13" Margin="0,5,0,18" />
                <TextBlock Text="Пробел — пауза" Foreground="#CBD5E1" FontSize="14" />
                <TextBlock Text="R — начать заново" Foreground="#CBD5E1" FontSize="14" Margin="0,7,0,0" />
            </StackPanel>

            <Border Grid.Column="1" BorderBrush="#334155" BorderThickness="2"
                    CornerRadius="8" Background="#111C2E" Padding="4">
                <Grid>
                    <Canvas x:Name="GameCanvas" Width="480" Height="480"
                            Background="#0B1220" ClipToBounds="True" />
                    <Grid x:Name="Overlay" Background="#E6111827" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="OverlayTitle" Text="Пауза" FontSize="38"
                                       FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock x:Name="OverlayMessage" Text="Нажмите пробел, чтобы продолжить"
                                       Foreground="#CBD5E1" FontSize="15" TextAlignment="Center"
                                       Margin="0,8,0,18" />
                            <Button x:Name="OverlayButton" Content="Продолжить"
                                    Click="OverlayButton_Click" Padding="18,9"
                                    Background="#22C55E" Foreground="#052E16"
                                    FontWeight="Bold" BorderThickness="0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="24,0,0,0">
                <TextBlock Text="ЦЕЛЬ" FontSize="13" FontWeight="Bold"
                           Foreground="#64748B" Margin="0,0,0,14" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Ellipse Width="14" Height="14" Fill="#FB7185" Margin="0,0,10,0" />
                    <TextBlock Text="Собирайте яблоки" Foreground="#CBD5E1" FontSize="14" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="14" Height="14" Fill="#4ADE80" RadiusX="3" RadiusY="3"
                               Margin="0,0,10,0" />
                    <TextBlock Text="Растите и набирайте очки" TextWrapping="Wrap"
                               Foreground="#CBD5E1" FontSize="14" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>